---
/*
 * Galerie produit : les vraies photos de assets/produits/[slug]/ quand elles
 * existent (AVIF + WebP, plusieurs tailles), sinon le rendu SVG / CSS du cadre.
 * Défilement natif (scroll-snap) et vignettes en ancres : aucun JavaScript requis.
 */
import { Picture } from 'astro:assets';
import CadreLed from './CadreLed.astro';
import SceneBureau from './SceneBureau.astro';
import type { NomScene } from '../../lib/pixel/scenes';
import { lien } from '../../lib/routes';
import { imageProduit } from '../../lib/medias';

export type ElementGalerie =
  | { type: 'photo'; src: string; alt: string; par_variante?: Record<string, string>; variantes?: string[] }
  | {
      type: 'rendu';
      scene: NomScene;
      vue?: 'face' | 'trois-quarts';
      bureau?: boolean;
      ambiance?: 'rose' | 'cyan' | 'violet';
      alt: string;
      basculable?: boolean;
    };

interface Props {
  slug: string;
  elements: ElementGalerie[];
  taille: 32 | 64;
  /** Variante choisie au chargement : sélectionne les photos propres à cette variante. */
  variante?: string;
  /** Mention sous la galerie, par exemple la variante photographiée. */
  legende?: string;
}
const { slug, elements, taille, variante, legende } = Astro.props;

// Chaque photo a une version par défaut (« * ») et, au besoin, une version par variante.
// Le script de la page produit bascule entre elles via l'événement « lumipix:variante ».
const resolus = await Promise.all(
  elements.map(async (e) =>
    e.type === 'photo'
      ? {
          ...e,
          versions: await Promise.all(
            [['*', e.src] as const, ...Object.entries(e.par_variante ?? {})].map(async ([cle, f]) => ({
              cle,
              image: await imageProduit(slug, f),
            })),
          ),
        }
      : e,
  ),
);
const avecPhotos = resolus.some((e) => e.type === 'photo');
const visibleDe = (e: (typeof resolus)[number]) => !(e.type === 'photo' && e.variantes && variante && !e.variantes.includes(variante));
const versionDe = (e: (typeof resolus)[number]) =>
  e.type === 'photo' && variante && e.par_variante?.[variante] ? variante : '*';
// Première diapositive visible au chargement : seule image chargée en priorité.
const premiere = resolus.findIndex(visibleDe);
---

<div class="galerie">
  <ul class="galerie-piste" aria-label="Galerie du produit">
    {
      resolus.map((e, i) => (
        <li
          class="galerie-diapo"
          id={`vue-${i + 1}`}
          data-pour={e.type === 'photo' && e.variantes ? e.variantes.join(' ') : undefined}
          hidden={!visibleDe(e)}
        >
          {e.type === 'photo' ? (
            e.versions.map((v) => {
              const active = v.cle === versionDe(e);
              return (
                <div class="galerie-version" data-version={v.cle} hidden={!active}>
                  <Picture
                    src={v.image}
                    alt={e.alt}
                    class="galerie-photo"
                    formats={['avif', 'webp']}
                    widths={[480, 800, 1100]}
                    sizes="(min-width: 64rem) 36rem, 100vw"
                    loading={i === premiere && active ? 'eager' : 'lazy'}
                    fetchpriority={i === premiere && active ? 'high' : undefined}
                  />
                </div>
              );
            })
          ) : e.bureau ? (
            <SceneBureau ambiance={e.ambiance}>
              <CadreLed scene={e.scene} taille={taille} vue={e.vue} alt={e.alt} prioritaire={i === 0} pied basculable={e.basculable} />
            </SceneBureau>
          ) : (
            <div class="galerie-fond">
              <CadreLed scene={e.scene} taille={taille} vue={e.vue} alt={e.alt} prioritaire={i === 0} basculable={e.basculable} />
            </div>
          )}
        </li>
      ))
    }
  </ul>
  <nav class="galerie-vignettes" aria-label="Choisir une vue">
    {
      resolus.map((e, i) => (
        <a
          href={`#vue-${i + 1}`}
          aria-label={`Vue ${i + 1} : ${e.alt}`}
          data-pour={e.type === 'photo' && e.variantes ? e.variantes.join(' ') : undefined}
          hidden={!visibleDe(e)}
        >
          {e.type === 'photo' ? (
            e.versions.map((v) => (
              <span class="galerie-version" data-version={v.cle} hidden={v.cle !== versionDe(e)}>
                <Picture src={v.image} alt="" formats={['avif', 'webp']} widths={[120]} sizes="60px" loading="lazy" />
              </span>
            ))
          ) : (
            <img src={lien(`/scenes/${e.scene}-32.svg`)} alt="" width="60" height="60" loading="lazy" decoding="async" />
          )}
        </a>
      ))
    }
  </nav>
  {legende && avecPhotos && <small class="galerie-legende">{legende}</small>}
</div>

<script>
  // Vignettes : défile la piste sans faire sauter la page.
  document.querySelectorAll<HTMLElement>('.galerie').forEach((g) => {
    const piste = g.querySelector<HTMLElement>('.galerie-piste');
    g.querySelectorAll<HTMLAnchorElement>('.galerie-vignettes a').forEach((a) => {
      a.addEventListener('click', (ev) => {
        const cible = g.querySelector<HTMLElement>(a.hash);
        if (!piste || !cible) return;
        ev.preventDefault();
        piste.scrollTo({ left: cible.offsetLeft - piste.offsetLeft, behavior: 'smooth' });
      });
    });
  });

  // Photos propres à la variante choisie (ex. écran 32x32 ou 64x64).
  const appliquerVariante = (id: string) => {
    document.querySelectorAll<HTMLElement>('.galerie [data-pour]').forEach((el) => {
      el.hidden = !el.dataset.pour!.split(' ').includes(id);
    });
    document.querySelectorAll<HTMLElement>('.galerie-diapo, .galerie-vignettes a').forEach((el) => {
      const versions = [...el.querySelectorAll<HTMLElement>(':scope > .galerie-version')];
      if (!versions.length) return;
      const cle = versions.some((v) => v.dataset.version === id) ? id : '*';
      versions.forEach((v) => (v.hidden = v.dataset.version !== cle));
    });
  };
  document.addEventListener('lumipix:variante', (ev) => appliquerVariante((ev as CustomEvent<string>).detail));
  const cochee = document.querySelector<HTMLInputElement>('input[name="variante"]:checked');
  if (cochee) appliquerVariante(cochee.value);
</script>

<style>
  .galerie {
    display: grid;
    gap: var(--e-3);
    min-width: 0;
  }
  .galerie-piste {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border: var(--b-pixel) solid var(--c-bordure);
  }
  .galerie-piste::-webkit-scrollbar {
    display: none;
  }
  .galerie-diapo {
    scroll-snap-align: start;
    min-width: 0;
  }
  .galerie-diapo :global(img) {
    width: 100%;
  }
  .galerie-diapo[hidden],
  .galerie-vignettes a[hidden],
  .galerie-version[hidden] {
    display: none;
  }
  .galerie-vignettes .galerie-version:not([hidden]) {
    display: contents;
  }
  /* Diapositives carrées : les photos du cadre ne sont jamais rognées */
  .galerie {
    --bureau-ratio: 1;
  }
  .galerie-diapo :global(.galerie-photo) {
    aspect-ratio: 1;
    height: 100%;
    object-fit: cover;
  }
  .galerie-legende {
    display: block;
    margin: 0;
    font-size: var(--t-xs);
    color: var(--c-texte-doux);
  }
  .galerie-fond {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    padding: 12%;
    background: radial-gradient(70% 60% at 50% 45%, #1d1a40, #0c0b1e);
  }
  .galerie-fond :global(.cadre) {
    --cadre-max: 22rem;
  }
  .galerie-vignettes {
    display: flex;
    gap: var(--e-2);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .galerie-vignettes a {
    flex: 0 0 auto;
    display: block;
    width: 56px;
    height: 56px;
    padding: 2px;
    border: 2px solid var(--c-bordure-ui);
    background: #030306;
  }
  .galerie-vignettes a:hover,
  .galerie-vignettes a:focus-visible {
    border-color: var(--c-cyan);
  }
  .galerie-vignettes img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
