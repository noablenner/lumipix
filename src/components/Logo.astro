---
/* Logo Lumipix : un cadre pixel avec un « L » lumineux. Dessin original. */
interface Props {
  taille?: number;
  avecTexte?: boolean;
}
const { taille = 32, avecTexte = true } = Astro.props;

const grille = [
  '##########',
  '#........#',
  '#.cc....j#',
  '#.cc.....#',
  '#.cc.....#',
  '#.cc.....#',
  '#.ccccr..#',
  '#.ccccr..#',
  '#........#',
  '##########',
];
const couleurs: Record<string, string> = {
  '#': 'var(--c-texte)',
  c: 'var(--c-cyan)',
  r: 'var(--c-rose)',
  j: 'var(--c-jaune)',
};
const pixels = grille.flatMap((ligne, y) =>
  [...ligne].flatMap((p, x) => (couleurs[p] ? [{ x, y, fill: couleurs[p] }] : [])),
);
---

<span class="logo">
  <svg
    width={taille}
    height={taille}
    viewBox="0 0 10 10"
    shape-rendering="crispEdges"
    aria-hidden="true"
    focusable="false"
  >
    {pixels.map((p) => <rect x={p.x} y={p.y} width="1" height="1" fill={p.fill} />)}
  </svg>
  {avecTexte && <span class="logo-texte">Lumipix</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
  }
  .logo svg {
    filter: drop-shadow(0 0 4px rgb(46 230 230 / 0.45));
  }
  .logo-texte {
    font-family: var(--f-pixel);
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: 0.04em;
    color: var(--c-texte);
  }
</style>
