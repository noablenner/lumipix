<!--
  Transition de page « en blocs » entre l'accueil et les collections
  (zones d'immersion). Transitions natives entre documents, sans JavaScript :
  elles ne jouent que si les deux pages incluent ce composant. La page produit
  ne l'inclut pas, pour rester instantanée. Coupée en mouvement réduit.
-->
<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    @view-transition {
      navigation: auto;
    }
    ::view-transition-old(root) {
      animation: 180ms steps(3, end) both lumipix-sortie;
    }
    ::view-transition-new(root) {
      animation: 360ms steps(6, end) both lumipix-blocs;
    }
  }
  @keyframes lumipix-sortie {
    to {
      opacity: 0;
    }
  }
  @keyframes lumipix-blocs {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
</style>
