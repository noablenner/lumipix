---
/*
 * Effets d'immersion (brief §5), réservés à l'accueil et aux collections :
 *  - transition de page en blocs entre ces pages (sans JavaScript) ;
 *  - barre de progression pixel ;
 *  - apparitions en blocs au défilement (.revele, .revele-groupe), cadre qui
 *    s'éloigne doucement (.parallaxe), allumage de l'écran au chargement (.allumage).
 * Animations liées au défilement en CSS natif : sans prise en charge du
 * navigateur, le contenu reste simplement visible. Tout est coupé en mouvement réduit.
 */
---

<div class="progression-pixels" aria-hidden="true"></div>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    @view-transition {
      navigation: auto;
    }
    ::view-transition-old(root) {
      animation: 180ms steps(3, end) both lumipix-sortie;
    }
    ::view-transition-new(root) {
      animation: 360ms steps(6, end) both lumipix-blocs;
    }

    /* Allumage de l'écran : scintillement bref, comme un vrai écran qui démarre */
    .allumage {
      animation: lumipix-allumage 900ms steps(1, end) both;
    }

    @supports (animation-timeline: view()) {
      .revele {
        animation: lumipix-revele steps(6, end) both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }
      .revele-groupe > * {
        animation: lumipix-revele steps(5, end) both;
        animation-timeline: view();
        animation-range: entry 0% entry 50%;
      }
      .revele-groupe > :nth-child(2) {
        animation-range: entry 8% entry 58%;
      }
      .revele-groupe > :nth-child(3) {
        animation-range: entry 16% entry 66%;
      }
      .revele-groupe > :nth-child(4) {
        animation-range: entry 24% entry 74%;
      }
      .parallaxe {
        animation: lumipix-parallaxe linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
      .progression-pixels {
        display: block;
        animation: lumipix-progression steps(32, end) both;
        animation-timeline: scroll(root block);
      }
      .separateur-pixels span {
        animation: lumipix-led steps(1, end) both;
        animation-timeline: view();
        animation-range: entry calc(var(--i) * 3%) entry calc(var(--i) * 3% + 4%);
      }
    }
  }

  .progression-pixels {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    height: 4px;
    background: linear-gradient(90deg, var(--c-rose), var(--c-violet), var(--c-cyan));
    transform-origin: left;
    transform: scaleX(0);
    pointer-events: none;
  }

  @keyframes lumipix-sortie {
    to {
      opacity: 0;
    }
  }
  @keyframes lumipix-blocs {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes lumipix-revele {
    from {
      opacity: 0;
      transform: translateY(40px);
      clip-path: inset(0 0 100% 0);
    }
    to {
      opacity: 1;
      transform: none;
      clip-path: inset(-40px);
    }
  }
  @keyframes lumipix-parallaxe {
    to {
      transform: translateY(-8%) scale(0.94);
      filter: brightness(0.6);
    }
  }
  @keyframes lumipix-progression {
    to {
      transform: scaleX(1);
    }
  }
  @keyframes lumipix-allumage {
    0% {
      filter: brightness(0.15);
    }
    18% {
      filter: brightness(0.9);
    }
    26% {
      filter: brightness(0.3);
    }
    40% {
      filter: brightness(1.15);
    }
    55%,
    100% {
      filter: none;
    }
  }
  @keyframes lumipix-led {
    from {
      background: var(--c-surface-2);
      box-shadow: none;
    }
    to {
      background: var(--led, var(--c-cyan));
      box-shadow: 0 0 8px var(--led, var(--c-cyan));
    }
  }
</style>
