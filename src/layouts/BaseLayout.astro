---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Consentement from '../components/Consentement.astro';
import { SOCIETE } from '../config/societe';
import { cheminPublic, estPrevisualisation, lien } from '../lib/routes';
import policeTitres from '../styles/fonts/jersey-10-latin-400-normal.woff2?url';

interface Props {
  /** Title unique de la page (le nom de marque est ajouté s'il manque). */
  title: string;
  description: string;
  /** Exclut la page des moteurs (admin, commande, démo). */
  noindex?: boolean;
  /** Chemin de l'image de partage (1200 x 630), par défaut /og/defaut.png. */
  imageOg?: string;
  typeOg?: 'website' | 'product' | 'article';
  /** Données structurées JSON-LD de la page. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, noindex = false, imageOg, typeOg = 'website', jsonLd } = Astro.props;
const titreComplet = title.includes(SOCIETE.marque) ? title : `${title} | ${SOCIETE.marque}`;
// Le canonique pointe toujours vers le domaine de production, même en prévisualisation.
const canonique = new URL(cheminPublic(Astro.url.pathname), SOCIETE.urlSite).href;
const indexer = !noindex && !estPrevisualisation;
// L'image de partage est servie par le déploiement courant (production ou prévisualisation).
const urlImageOg = new URL(lien(imageOg ?? '/og/defaut.png'), Astro.site).href;
const jetonAnalytics = import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="fr-FR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    {!indexer && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0a0a18" />
    <link rel="icon" href={lien('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={policeTitres} as="font" type="font/woff2" crossorigin />

    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={SOCIETE.marque} />
    <meta property="og:type" content={typeOg} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={urlImageOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titreComplet} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={urlImageOg} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  </head>
  <body>
    <a class="lien-evitement" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <!-- Bandeau de consentement : Google Analytics ne se charge qu'après accord (brief §9) -->
    <Consentement />
    <script>
      import { memoriserOrigine } from '../scripts/origine';
      memoriserOrigine();
    </script>
    {
      jetonAnalytics && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: jetonAnalytics })}
        />
      )
    }
  </body>
</html>
